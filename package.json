{
  "name": "prompt-god",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA that teaches prompt engineering for every major AI model.",
  "license": "MIT",
  "homepage": "https://prompt-god.bossincrypto.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOSSincrypto/prompt-god.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "budget": "node scripts/check-bundle-budget.mjs",
    "verify": "npm run lint && npm run check:regex && npm run format:check && npm run typecheck && npm run test && npm run build:only && npm run budget",
    "check:regex": "node scripts/check-regex-boundaries.mjs"
  },
  "dependencies": {
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.8.0",
    "happy-dom": "20.11.1",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
